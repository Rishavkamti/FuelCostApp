<?xml version="1.0" encoding="utf-8"?>
<!--
    packageNames: yaha un delivery-partner apps ke package names daalo jinko
    monitor karna hai. Exact package name pata karne ke liye phone mein
    "adb shell dumpsys window | grep mCurrentFocus" chalao jab woh app khula ho,
    ya "Package Name Viewer" jaisa app Play Store se install karo.
    Neeche best-guess names diye hain - inko verify/update karna padega.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="200"
    android:packageNames="in.swiggy.deliveryapp,com.zomato.delivery" />
